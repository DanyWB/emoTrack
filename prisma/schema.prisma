generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SleepMode {
  hours
  quality
  both
}

enum SummaryPeriodType {
  d7
  d30
  all
}

enum EventType {
  work
  study
  relationships
  family
  friends
  health
  sleep
  sport
  rest
  money
  travel
  other
}

enum DailyMetricInputType {
  score
  sleep_block
}

enum FeedbackType {
  bug
  idea
  question
  review
  other
}

enum FeedbackStatus {
  unread
  reviewed
  closed
}

enum AnnouncementType {
  update
  important
  maintenance
  poll
  other
}

enum AnnouncementAudience {
  consented
}

enum AnnouncementStatus {
  draft
  ready
  sending
  sent
  partially_failed
  failed
  cancelled
}

enum AnnouncementDeliveryStatus {
  pending
  sent
  failed
  blocked
}

model User {
  id                           String                 @id @default(uuid())
  telegramId                   BigInt                 @unique @db.BigInt
  username                     String?
  firstName                    String?
  languageCode                 String                 @default("ru")
  timezone                     String                 @default("Europe/Berlin")
  onboardingCompleted          Boolean                @default(false)
  consentGiven                 Boolean                @default(false)
  remindersEnabled             Boolean                @default(true)
  reminderTime                 String?                @db.VarChar(5)
  sleepMode                    SleepMode              @default(both)
  trackMood                    Boolean                @default(true)
  trackEnergy                  Boolean                @default(true)
  trackStress                  Boolean                @default(true)
  trackSleep                   Boolean                @default(true)
  notesEnabled                 Boolean                @default(true)
  tagsEnabled                  Boolean                @default(true)
  eventsEnabled                Boolean                @default(true)
  checkinV2OnboardingCompleted Boolean                @default(false)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  dailyEntries                 DailyEntry[]
  trackedMetrics               UserTrackedMetric[]
  metricPreferences            UserMetricPreference[]
  events                       Event[]
  summaries                    Summary[]
  fsmSession                   FsmSession?
  productEvents                ProductEvent[]
  feedbackItems                FeedbackItem[]
  announcementDeliveries       AnnouncementDelivery[]
  announcementPollVotes        AnnouncementPollVote[]

  @@index([consentGiven, id])
  @@map("users")
}

model DailyEntry {
  id             String                    @id @default(uuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryDate      DateTime                  @db.Date
  moodScore      Int?
  energyScore    Int?
  stressScore    Int?
  sleepHours     Decimal?                  @db.Decimal(4, 2)
  sleepQuality   Int?
  noteText       String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  metricValues   DailyEntryMetricValue[]
  v2MetricValues DailyEntryV2MetricValue[]
  tags           DailyEntryTag[]
  events         Event[]

  @@unique([userId, entryDate])
  @@index([userId, entryDate])
  @@map("daily_entries")
}

model DailyMetricDefinition {
  id             String                  @id @default(uuid())
  key            String                  @unique
  label          String
  category       String?
  inputType      DailyMetricInputType    @default(score)
  defaultEnabled Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  trackedByUsers UserTrackedMetric[]
  entryValues    DailyEntryMetricValue[]

  @@index([isActive, sortOrder])
  @@map("daily_metric_definitions")
}

model UserTrackedMetric {
  id                 String                @id @default(uuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricDefinitionId String
  metricDefinition   DailyMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)
  isEnabled          Boolean               @default(false)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([userId, metricDefinitionId])
  @@index([userId, isEnabled, sortOrder])
  @@map("user_tracked_metrics")
}

model DailyEntryMetricValue {
  id                 String                @id @default(uuid())
  dailyEntryId       String
  dailyEntry         DailyEntry            @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  metricDefinitionId String
  metricDefinition   DailyMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)
  value              Int
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([dailyEntryId, metricDefinitionId])
  @@index([metricDefinitionId, dailyEntryId])
  @@map("daily_entry_metric_values")
}

model DailyEntryV2MetricValue {
  id           String                  @id @default(uuid())
  dailyEntryId String
  dailyEntry   DailyEntry              @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  metricKey    String
  ordinalValue Int
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  tags         DailyEntryV2MetricTag[]

  @@unique([dailyEntryId, metricKey])
  @@index([metricKey, dailyEntryId])
  @@map("daily_entry_v2_metric_values")
}

model DailyEntryV2MetricTag {
  id                      String                  @id @default(uuid())
  dailyEntryMetricValueId String
  metricValue             DailyEntryV2MetricValue @relation(fields: [dailyEntryMetricValueId], references: [id], onDelete: Cascade)
  tagKey                  String

  @@unique([dailyEntryMetricValueId, tagKey])
  @@map("daily_entry_v2_metric_tags")
}

model UserMetricPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricKey String
  enabled   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metricKey])
  @@index([userId, enabled, sortOrder])
  @@map("user_metric_preferences")
}

model PredefinedTag {
  id         String          @id @default(uuid())
  key        String          @unique
  label      String
  category   String?
  isActive   Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  dailyLinks DailyEntryTag[]

  @@map("predefined_tags")
}

model DailyEntryTag {
  id           String        @id @default(uuid())
  dailyEntryId String
  dailyEntry   DailyEntry    @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  tagId        String
  tag          PredefinedTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([dailyEntryId, tagId])
  @@map("daily_entry_tags")
}

model Event {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyEntryId   String?
  dailyEntry     DailyEntry? @relation(fields: [dailyEntryId], references: [id], onDelete: SetNull)
  eventDate      DateTime    @db.Date
  eventEndDate   DateTime?   @db.Date
  seriesId       String?
  seriesPosition Int?
  eventType      EventType
  title          String
  description    String?
  eventScore     Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([seriesId, seriesPosition])
  @@index([userId, eventDate])
  @@index([userId, eventDate, eventEndDate])
  @@index([userId, seriesId])
  @@map("events")
}

model Summary {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType  SummaryPeriodType
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  payloadJson Json
  generatedAt DateTime          @default(now())

  @@index([userId, periodType, periodEnd])
  @@map("summaries")
}

model FsmSession {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state       String
  payloadJson Json
  updatedAt   DateTime @updatedAt

  @@map("fsm_sessions")
}

model ProductEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName   String
  payloadJson Json
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
  @@map("product_events")
}

model FeedbackItem {
  id           String         @id @default(uuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  feedbackType FeedbackType
  message      String
  status       FeedbackStatus @default(unread)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("feedback_items")
}

model AnnouncementCampaign {
  id                        String                       @id @default(uuid())
  type                      AnnouncementType
  title                     String                       @default("")
  body                      String                       @default("")
  audience                  AnnouncementAudience         @default(consented)
  status                    AnnouncementStatus           @default(draft)
  createdByAdminTelegramId  BigInt                       @db.BigInt
  imageTelegramFileId       String?
  imageTelegramFileUniqueId String?
  imageAddedAt              DateTime?
  pollToken                 String?                      @unique
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  confirmedAt               DateTime?
  startedAt                 DateTime?
  finishedAt                DateTime?
  deliveries                AnnouncementDelivery[]
  pollOptions               AnnouncementPollOption[]
  pollVotes                 AnnouncementPollVote[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("announcement_campaigns")
}

model AnnouncementDelivery {
  id                 String                     @id @default(uuid())
  campaignId         String
  campaign           AnnouncementCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId         BigInt                     @db.BigInt
  status             AnnouncementDeliveryStatus @default(pending)
  telegramMessageIds Json?
  errorCode          String?
  errorMessage       String?
  attempts           Int                        @default(0)
  sentAt             DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([campaignId, status, id])
  @@index([userId, createdAt])
  @@map("announcement_deliveries")
}

model AnnouncementPollOption {
  id         String                 @id @default(uuid())
  campaignId String
  campaign   AnnouncementCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int
  createdAt  DateTime               @default(now())
  votes      AnnouncementPollVote[]

  @@unique([campaignId, sortOrder])
  @@index([campaignId, sortOrder])
  @@map("announcement_poll_options")
}

model AnnouncementPollVote {
  id         String                     @id @default(uuid())
  campaignId String
  campaign   AnnouncementCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  optionId   String
  option     AnnouncementPollOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId     String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime                   @default(now())

  @@unique([campaignId, userId])
  @@index([campaignId, optionId])
  @@map("announcement_poll_votes")
}
